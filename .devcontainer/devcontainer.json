// https://github.com/devcontainers/images/tree/main/src/rust
// https://www.debian.org/releases/
{
	"name": "gstreamer-snapcast-rs",
	"build": {
		"dockerfile": "Dockerfile"
	},
	// Needed for lldb/gdb (ptrace) inside the container.
	// --device=/dev/snd: host sound devices, in particular the snd-aloop loopback card
	// for timing tests (`sudo modprobe snd-aloop` on the host first). The container does
	// not start on a host without /dev/snd: remove the line there. With rootless Podman
	// and --userns=keep-id, the host user's ACLs on /dev/snd/* apply inside the container.
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt",
		"seccomp=unconfined",
		"--device=/dev/snd"
	],

	"containerEnv": {
		// Lets gst-launch-1.0 / gst-inspect-1.0 find the freshly built plugins.
		"GST_PLUGIN_PATH": "${containerWorkspaceFolder}/target/debug",
		"RUST_BACKTRACE": "1"
	},

	// Fetch the snapcast-rs submodule and install the toolchain from rust-toolchain.toml.
	"postCreateCommand": "git submodule update --init --recursive && rustup show active-toolchain",

	// Configure tool-specific properties.
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			// Set *default* container specific settings.json values on container create.
			"settings": {
				"lldb.executable": "/usr/bin/lldb",
				// VS Code don't watch files under ./target
				"files.watcherExclude": {
					"**/target/**": true
				},
				"rust-analyzer.check.command": "clippy"
			},

			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"vadimcn.vscode-lldb",
				"mutantdino.resourcemonitor",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"fill-labs.dependi",
				"Anthropic.claude-code"
			]
		}
	},

	// Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
	"remoteUser": "vscode"
}
